# 服务端口
PORT=3300

# SQLite 数据目录（默认 <repo>/data）
# RG_DATA_DIR=./data

# 应用目录根：每个应用一个子目录（默认 <repo>/projects）
# RG_PROJECTS_DIR=./projects

# opencode 可执行文件（默认从 PATH 查找；Windows 常为 opencode.cmd）
# OPENCODE_BIN=C:\Users\you\AppData\Roaming\npm\opencode.cmd

# 工作台拥有的 opencode serve 端口（只监听 127.0.0.1）
OPENCODE_PORT=4771
# 首页/启动时自动探测并拉起 opencode serve（默认 true；false 关闭）
# OPENCODE_AUTO_START=true
# 启动等待上限（毫秒）
# OPENCODE_START_TIMEOUT_MS=60000
# 可选：覆盖默认模型（provider/model；默认取 opencode /api/model/default）
# OPENCODE_DEFAULT_MODEL=

# 说明：工作台不再保存任何模型 API Key；provider/model 由 opencode 自身配置管理。
