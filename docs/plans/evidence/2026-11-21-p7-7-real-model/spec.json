{
  "schemaVersion": 1,
  "id": "supplier-management",
  "name": "供应商管理模板",
  "description": "供应商主数据台账：列表检索与批量操作、弹窗新建/编辑、详情查看。",
  "baseApplicationType": "operations-management",
  "style": "data-cyan",
  "pages": [
    {
      "id": "supplier-list",
      "name": "供应商列表",
      "kind": "reference",
      "description": "复用运营管理后台列表页：左侧检索与概况、右侧台账表格、行内筛选与紧凑分页。",
      "source": {
        "pack": "afcenter-app-templates-v1",
        "applicationType": "operations-management",
        "pageId": "list"
      }
    },
    {
      "id": "supplier-form",
      "name": "供应商新建/编辑",
      "kind": "contract",
      "type": "form",
      "recipe": "dialog-form",
      "description": "弹窗内分组维护供应商基础信息、合作与结算、联系信息及补充说明。",
      "contract": {
        "form": {
          "presentation": "dialog",
          "columns": 2,
          "width": 900,
          "groups": [
            {
              "title": "基础信息",
              "fields": ["code", "name", "category", "level"]
            },
            {
              "title": "合作与结算",
              "fields": ["status", "settleTerm", "creditLimit", "cooperationDate"]
            },
            {
              "title": "联系信息",
              "fields": ["contact", "phone", "email", "region"]
            },
            {
              "title": "补充说明",
              "fields": ["owner", "address", "remark"]
            }
          ]
        },
        "components": {
          "category": "pm-select",
          "level": "pm-select",
          "status": "pm-select",
          "settleTerm": "pm-select",
          "creditLimit": "pm-number",
          "cooperationDate": "pm-datepicker",
          "owner": "pm-select-user",
          "address": "pm-textarea",
          "remark": "pm-textarea"
        }
      },
      "sampleEntity": {
        "id": "supplier",
        "name": "供应商",
        "fields": [
          { "name": "code", "label": "供应商编号", "type": "string", "required": true, "unique": true },
          { "name": "name", "label": "供应商名称", "type": "string", "required": true },
          { "name": "category", "label": "供应品类", "type": "enum", "options": ["原材料", "包装材料", "物流服务", "设备配件", "办公用品"] },
          { "name": "level", "label": "供应商等级", "type": "enum", "options": ["战略供应商", "核心供应商", "普通供应商", "备选供应商"] },
          { "name": "status", "label": "合作状态", "type": "enum", "options": ["合作中", "待审核", "已暂停", "已淘汰"] },
          { "name": "settleTerm", "label": "结算方式", "type": "enum", "options": ["月结30天", "月结60天", "货到付款", "预付款"] },
          { "name": "creditLimit", "label": "授信额度（元）", "type": "decimal" },
          { "name": "cooperationDate", "label": "合作起始日期", "type": "date" },
          { "name": "contact", "label": "联系人", "type": "string" },
          { "name": "phone", "label": "联系电话", "type": "string" },
          { "name": "email", "label": "邮箱", "type": "string" },
          { "name": "region", "label": "所在地区", "type": "string" },
          { "name": "owner", "label": "采购负责人", "type": "ref", "ref": "user" },
          { "name": "address", "label": "详细地址", "type": "text" },
          { "name": "remark", "label": "备注", "type": "text" }
        ]
      }
    },
    {
      "id": "supplier-detail",
      "name": "供应商详情",
      "kind": "contract",
      "type": "detail",
      "recipe": "detail",
      "description": "展示供应商主数据、合作状态、结算方式、授信额度与联系信息。",
      "contract": {
        "columns": [
          "code",
          "name",
          "category",
          "level",
          "status",
          "settleTerm",
          "creditLimit",
          "cooperationDate",
          "contact",
          "phone",
          "email",
          "region",
          "owner",
          "address",
          "remark"
        ]
      },
      "sampleEntity": {
        "id": "supplier",
        "name": "供应商",
        "fields": [
          { "name": "code", "label": "供应商编号", "type": "string", "required": true, "unique": true },
          { "name": "name", "label": "供应商名称", "type": "string", "required": true },
          { "name": "category", "label": "供应品类", "type": "enum", "options": ["原材料", "包装材料", "物流服务", "设备配件", "办公用品"] },
          { "name": "level", "label": "供应商等级", "type": "enum", "options": ["战略供应商", "核心供应商", "普通供应商", "备选供应商"] },
          { "name": "status", "label": "合作状态", "type": "enum", "options": ["合作中", "待审核", "已暂停", "已淘汰"] },
          { "name": "settleTerm", "label": "结算方式", "type": "enum", "options": ["月结30天", "月结60天", "货到付款", "预付款"] },
          { "name": "creditLimit", "label": "授信额度（元）", "type": "decimal" },
          { "name": "cooperationDate", "label": "合作起始日期", "type": "date" },
          { "name": "contact", "label": "联系人", "type": "string" },
          { "name": "phone", "label": "联系电话", "type": "string" },
          { "name": "email", "label": "邮箱", "type": "string" },
          { "name": "region", "label": "所在地区", "type": "string" },
          { "name": "owner", "label": "采购负责人", "type": "ref", "ref": "user" },
          { "name": "address", "label": "详细地址", "type": "text" },
          { "name": "remark", "label": "备注", "type": "text" }
        ]
      }
    }
  ]
}
